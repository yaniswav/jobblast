# JobBlast environment variables.
# Copy to `.env` at the repo root and fill in your own values. `.env` is
# gitignored; this file is the committed, placeholder-only reference.
#
# Everything that is *user-specific but not secret* (your name, target
# companies, scoring rules, job sources...) lives in jobblast.config.json
# instead - see docs/CONFIG.md.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Postgres connection string used by Drizzle (lib/db).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobblast

# Optional: name of the Docker container the deploy/start-jobblast.* scripts
# should start/wait on before launching the API. Only matters if you renamed
# `container_name` in docker-compose.yml (e.g. to run a second JobBlast
# checkout without colliding with an existing container of the same name).
# Defaults to "jobblast-pg" - the name docker-compose.yml uses out of the box.
# PG_CONTAINER_NAME=jobblast-pg

# ---------------------------------------------------------------------------
# API server (artifacts/api-server)
# ---------------------------------------------------------------------------
# Port the Express API listens on. Required - the server refuses to start
# without it.
PORT=5000

# "development" or "production".
NODE_ENV=development

# Set to 1 to have the API process also serve the already-built frontend
# (artifacts/jobblast/dist/public) with an SPA fallback, so a single Node
# process serves the whole app. Leave unset during frontend dev (Vite serves
# it instead and proxies /api).
SERVE_STATIC=1

# Optional: path to the config file, absolute or relative to the repo root.
# Defaults to <repo root>/jobblast.config.json.
# JOBBLAST_CONFIG=jobblast.config.json

# ---------------------------------------------------------------------------
# AI provider keys (all optional)
#
# Which engine writes your cover letters is chosen in jobblast.config.json
# under `ai.provider` - see docs/CONFIG.md. Only the *keys* live here, so a
# config file stays safe to share.
#
# The default provider (`claude-cli`) needs no key at all: it rides the
# `claude` CLI you are already logged into. Neither does `ollama` /
# `lmstudio` (local servers), nor `none` (no AI at all).
# ---------------------------------------------------------------------------
# Needed only for `"provider": "anthropic-api"`.
# Create one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Needed only for `"provider": "openai-compatible"` pointed at OpenAI.
# For another endpoint (OpenRouter, Mistral, Groq...), name its variable in
# `ai.openaiCompatible.apiKeyEnv` and set that variable here instead.
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Job source credentials (all optional - a source without credentials is
# skipped with a log line instead of failing the refresh)
# ---------------------------------------------------------------------------
# France Travail "Offres d'emploi v2" API (OAuth2 client credentials).
# Register at https://francetravail.io/
FRANCETRAVAIL_CLIENT_ID=PAR_yourapp_0000000000000000000000000000000000000000
FRANCETRAVAIL_CLIENT_SECRET=00000000000000000000000000000000000000000000000000

# Adzuna job search API. Register at https://developer.adzuna.com/
ADZUNA_APP_ID=00000000
ADZUNA_APP_KEY=00000000000000000000000000000000

# ---------------------------------------------------------------------------
# Frontend dev server (artifacts/jobblast, Vite) - only needed for `pnpm dev`
# ---------------------------------------------------------------------------
# Vite dev/preview port. Separate from PORT so the API and the frontend can
# both read this one .env without clashing. Defaults to 5173.
FRONTEND_PORT=5173

# Where the Vite dev server proxies /api requests. Defaults to
# http://localhost:5000 - change it if you changed PORT.
API_PROXY_TARGET=http://localhost:5000

# Base path the frontend is served under. Defaults to "/".
# BASE_PATH=/

# ---------------------------------------------------------------------------
# SaaS mode only - IGNORE THIS WHOLE BLOCK for a self-hosted install
# ---------------------------------------------------------------------------
# JobBlast runs as one of two products from one codebase. Leave JOBBLAST_MODE
# unset (or set it to "selfhosted") and everything below is irrelevant: there
# is no login screen, no accounts, and your configuration stays in
# jobblast.config.json. See docs/SAAS-ARCHITECTURE.md.
#
# Setting it to "saas" turns on email + password accounts, per-account
# configuration in the database, and turns OFF the CLI-backed features
# (AI Scout, Notion Inbox, Gmail sync, interview briefs) and the background
# aggregation timers.
# JOBBLAST_MODE=selfhosted

# Required in saas mode: the exact origin the browser app is served from.
# Used by the CSRF origin check on every unsafe request. The server refuses
# to boot in saas mode without it.
# APP_ORIGIN=https://jobblast.example.com

# Set to 0 to drop the Secure flag from the session cookie, for a local saas
# run over plain HTTP. Never do this on a real deployment.
# SESSION_COOKIE_SECURE=1

# Optional: salt for the sha256(ip) stored on session rows for abuse triage.
# Unset means no IP is stored at all, which is the safer default.
# JOBBLAST_IP_SALT=

# Optional: hard cap on the number of accounts, checked at registration.
# Defaults to 150, the beta size docs/SAAS-ARCHITECTURE.md plans for.
# JOBBLAST_MAX_ACCOUNTS=150
