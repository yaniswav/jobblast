# deploy/saas/.env.docker - env file for the prod-like local stack
# (deploy/saas/compose.yaml). Copy this to deploy/saas/.env.docker and fill
# in real values; that file is gitignored and never baked into the image.
# See docs/DOCKER.md for the full walkthrough and docs/SAAS-ARCHITECTURE.md
# section 7 for why each of these exists.
#
# NO REAL SECRET BELONGS IN THIS EXAMPLE FILE. Every value below is a
# placeholder or an obviously-fake local default.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Postgres password for the `db` service. Compose builds DATABASE_URL from
# this (see compose.yaml) - you do not set DATABASE_URL directly here.
# Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=changeme-generate-a-real-password

# 32-byte base64 master key encrypting every account's BYOK AI provider
# credentials (AES-256-GCM). The server refuses to boot without a valid one.
# Never share this value, never commit it - losing it makes every stored key
# permanently undecryptable.
# Generate one with: openssl rand -base64 32
JOBBLAST_MASTER_KEY=

# The exact origin the browser hits, used by the CSRF origin check on every
# unsafe request. For this local stack, that is Caddy on the host port below
# (compose.yaml maps it to 8080). Change the port to match if you edit that
# mapping; change the whole value once you have a real domain (lot F).
APP_ORIGIN=http://localhost:8080

# ---------------------------------------------------------------------------
# Local-only (this stack has no TLS yet - see docs/DOCKER.md)
# ---------------------------------------------------------------------------
# Caddy serves plain HTTP locally (deploy/saas/Caddyfile), so the session
# cookie's Secure flag has to come off or the browser will refuse to send it
# back. Set this to 1 (or delete the line) once JOBBLAST_DOMAIN below points
# at a real domain and Caddy is doing automatic HTTPS.
SESSION_COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Real domain for Caddy's automatic HTTPS (lot F). Leave unset for the local
# stack - deploy/saas/Caddyfile then serves plain http://localhost.
# JOBBLAST_DOMAIN=jobblast.example.com

# Runs the published GHCR image instead of building from source - see
# docs/DOCKER.md "Using the published image". Leave unset to build locally
# (compose.yaml's default, jobblast-saas:local) as today.
# JOBBLAST_IMAGE=ghcr.io/yaniswav/jobblast:latest

# How many background jobs the in-process worker runs at once. Defaults to 4
# if unset - docs/SAAS-ARCHITECTURE.md section 6.
# JOBBLAST_WORKER_CONCURRENCY=4

# Hard cap on the number of accounts, checked at registration. Defaults to
# 150 if unset.
# JOBBLAST_MAX_ACCOUNTS=150

# Salt for the sha256(ip) stored on session rows for abuse triage. Unset
# means no IP is stored at all, which is the safer default.
# JOBBLAST_IP_SALT=

# Job source credentials - a source without credentials is skipped with a
# log line instead of failing the refresh. Same variables as the root
# .env.example; see docs/CONFIG.md.
# FRANCETRAVAIL_CLIENT_ID=
# FRANCETRAVAIL_CLIENT_SECRET=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Free key at https://jooble.org/api/about
# JOOBLE_API_KEY=
# Free affiliate id ("affid") at https://www.careerjet.com/partners/api/
# CAREERJET_API_KEY=

# Needed only if a user's BYOK setup can't cover something the platform
# should provide by default. Usually left unset - BYOK is per-account
# (docs/SAAS-ARCHITECTURE.md section 5).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Operator identity for the Privacy page, linked from the login screen and
# Settings. Every operator running their own beta fills in their own - none
# of this is hardcoded in the repo. Leaving JOBBLAST_LEGAL_OPERATOR unset
# makes the page report itself as "not configured" rather than showing a
# page full of blanks.
# JOBBLAST_LEGAL_OPERATOR=Your Name or Company
# JOBBLAST_LEGAL_ADDRESS=Your postal address
# JOBBLAST_LEGAL_CONTACT=you@example.com
# JOBBLAST_LEGAL_COUNTRY=Your country

# Daily per-account caps on AI job kinds. Defaults are 40 letters, 60 fit
# analyses, 5 briefs per day if unset; set to 0 to disable a cap entirely.
# JOBBLAST_QUOTA_TAILOR_PER_DAY=40
# JOBBLAST_QUOTA_FIT_PER_DAY=60
# JOBBLAST_QUOTA_BRIEF_PER_DAY=5

# How many days an unreferenced shared posting is kept before the daily
# prune job removes it. Defaults to 90.
# JOBBLAST_POSTING_RETENTION_DAYS=90

# Previous master key, only set while running `pnpm run rotate-byok`
# (see docs/DOCKER.md "Rotating the BYOK master key"). Not needed otherwise.
# JOBBLAST_MASTER_KEY_PREVIOUS=

# Comma-separated ids from the built-in company catalog
# (lib/sources/ats/catalog.ts), fetched into the shared postings pool on
# every refresh cycle regardless of whether any account watches them - so
# the anonymous /try trial has something current to match against right
# after a fresh deploy, before the first real account exists (lot H5). Saas
# only; ignored entirely in selfhosted. Unset means no instance watches at
# all, which is a legitimate choice for a small/private instance. Suggested
# default: a dozen large, frequently-hiring French employers already in the
# catalog.
# JOBBLAST_INSTANCE_WATCHES=thales,alten,assystem,doctolib,algolia,dataiku,mirakl,contentsquare,qonto,blablacar,scaleway,ledger

# ---------------------------------------------------------------------------
# Email transport (G2 lot) - password reset and the 11-month inactivity
# warning. Defaults to "none": no error, nothing sent, both features stay
# disabled (the frontend hides "forgot password"; the inactivity pass never
# warns or deletes - see docs/DOCKER.md "Mailpit"). Set to "smtp" and fill in
# the group below to turn both on.
# JOBBLAST_EMAIL_TRANSPORT=none

# Uncomment these four to test locally against the `mailpit` service
# (docker compose --profile dev up -d mailpit - see docs/DOCKER.md). Mailpit
# accepts unauthenticated local SMTP, so JOBBLAST_SMTP_USER/PASS stay unset.
# JOBBLAST_EMAIL_TRANSPORT=smtp
# JOBBLAST_SMTP_HOST=mailpit
# JOBBLAST_SMTP_PORT=1025
# JOBBLAST_EMAIL_FROM=JobBlast <no-reply@jobblast.local>

# A real deployment points the same four variables (plus user/pass) at a
# free-tier relay instead - Brevo (300/day) or Resend (3000/month) both work
# over plain SMTP. Never run your own mail server; see
# docs/SAAS-ARCHITECTURE.md section 2 for why.
# JOBBLAST_SMTP_HOST=smtp-relay.brevo.com
# JOBBLAST_SMTP_PORT=587
# JOBBLAST_SMTP_USER=
# JOBBLAST_SMTP_PASS=
# JOBBLAST_EMAIL_FROM=JobBlast <no-reply@your-domain.example>
